{
  "name": "flowdeck-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:workspace": "playwright test tests/e2e/workspace-upload.spec.ts",
    "test:e2e:errors": "playwright test tests/e2e/workspace-error-states.spec.ts",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:unit": "playwright test --config playwright.unit.config.ts",
    "test:e2e:public": "playwright test --config playwright.public.config.ts"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": { "postcss": "$postcss" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.3"
  }
}
